{
    "name": "codeva/laravel-watch",
    "description": "Codeva Watch client package and local agent for Laravel applications.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "ext-zlib": "*",
        "laravel/framework": "^12.0|^13.0",
        "monolog/monolog": "^3.6",
        "nesbot/carbon": "^2.0|^3.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "ramsey/uuid": "^4.0",
        "react/event-loop": "^1.5",
        "react/promise": "^3.2",
        "react/socket": "^1.16",
        "symfony/console": "^7.1|^8.0",
        "symfony/http-foundation": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "spatie/laravel-health": "^1.34"
    },
    "suggest": {
        "spatie/laravel-health": "GET /watch/health reuses its checks when installed"
    },
    "autoload": { "psr-4": { "Codeva\\Watch\\": "src/" } },
    "autoload-dev": { "psr-4": { "Codeva\\Watch\\Tests\\": "tests/" } },
    "bin": ["bin/watch-agent"],
    "extra": { "laravel": { "providers": ["Codeva\\Watch\\WatchServiceProvider"], "aliases": { "Watch": "Codeva\\Watch\\Facades\\Watch" } } },
    "minimum-stability": "stable",
    "config": { "allow-plugins": { "pestphp/pest-plugin": true }, "sort-packages": true }
}
